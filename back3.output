Grammar

    0 $accept: axiom $end

    1 axiom: exprSeq

    2 $@1: ε

    3 exprSeq: form $@1 r_exprSeq

    4 r_exprSeq: exprSeq
    5          | ε

    6 exprSeqOpt: exprSeq
    7           | ε

    8 form: expression
    9     | '(' SETQ IDENTIF expression ')'
   10     | '(' SETF IDENTIF expression ')'
   11     | '(' PRINT STRING ')'
   12     | '(' PRINT expression ')'
   13     | '(' PRINC STRING ')'
   14     | '(' PRINC expression ')'
   15     | '(' PROGN exprSeqOpt ')'
   16     | '(' MAIN ')'
   17     | '(' IDENTIF ')'

   18 $@2: ε

   19 form: '(' DEFUN MAIN $@2 '(' ')' exprSeqOpt ')'

   20 $@3: ε

   21 $@4: ε

   22 form: '(' LOOP WHILE $@3 expression $@4 DO exprSeqOpt ')'
   23     | '(' ifHead form ')'

   24 $@5: ε

   25 form: '(' ifHead form $@5 form ')'

   26 ifHead: IF expression

   27 expression: operand
   28           | '(' '+' expression expression ')'
   29           | '(' '-' expression expression ')'
   30           | '(' '*' expression expression ')'
   31           | '(' '/' expression expression ')'
   32           | '(' MOD expression expression ')'
   33           | '(' AND expression expression ')'
   34           | '(' OR expression expression ')'
   35           | '(' NOT expression ')'
   36           | '(' '<' expression expression ')'
   37           | '(' LE expression expression ')'
   38           | '(' '>' expression expression ')'
   39           | '(' GE expression expression ')'
   40           | '(' '=' expression expression ')'
   41           | '(' EQ expression expression ')'
   42           | '(' NE expression expression ')'
   43           | '(' '-' expression ')'

   44 operand: IDENTIF
   45        | number

   46 number: NUMBER


