Grammar

    0 $accept: axioma $end

    1 axioma: top_level_list funcion_main

    2 top_level_list: ε
    3               | top_level_list declaracion ';'
    4               | top_level_list funcion

    5 $@1: ε

    6 funcion: INTEGER IDENTIF '(' $@1 parametros ')' '{' declaraciones_locales lista_sentencias '}'

    7 $@2: ε

    8 funcion: IDENTIF '(' $@2 parametros ')' '{' declaraciones_locales lista_sentencias '}'

    9 parametros: ε
   10           | lista_parametros

   11 lista_parametros: INTEGER IDENTIF
   12                 | IDENTIF
   13                 | lista_parametros ',' INTEGER IDENTIF
   14                 | lista_parametros ',' IDENTIF

   15 declaraciones_locales: ε
   16                      | declaraciones_locales declaracion_local ';'

   17 declaracion: INTEGER lista_vars

   18 declaracion_local: INTEGER lista_vars_locales

   19 lista_vars: vars
   20           | vars ',' lista_vars

   21 lista_vars_locales: vars_locales
   22                   | vars_locales ',' lista_vars_locales

   23 vars: IDENTIF
   24     | IDENTIF '=' cte
   25     | IDENTIF '[' cte ']'

   26 vars_locales: IDENTIF
   27             | IDENTIF '=' cte
   28             | IDENTIF '[' cte ']'

   29 cte: NUMBER
   30    | '+' NUMBER
   31    | '-' NUMBER

   32 $@3: ε

   33 funcion_main: INTEGER MAIN $@3 '(' ')' '{' declaraciones_locales lista_sentencias '}'

   34 $@4: ε

   35 funcion_main: MAIN $@4 '(' ')' '{' declaraciones_locales lista_sentencias '}'

   36 lista_sentencias: ε
   37                 | lista_sentencias sentencia ';'
   38                 | lista_sentencias sentencia_control

   39 lista_argumentos: argumento_printf
   40                 | argumento_printf ',' lista_argumentos

   41 argumento_printf: expresion
   42                 | STRING

   43 lista_expr: ε
   44           | expresion
   45           | expresion ',' lista_expr

   46 sentencia: IDENTIF '=' expresion
   47          | IDENTIF '[' expresion ']' '=' expresion
   48          | RETURN expresion
   49          | PUTS '(' STRING ')'
   50          | PRINTF '(' STRING ')'
   51          | PRINTF '(' STRING ',' lista_argumentos ')'
   52          | PRINTF '(' expresion ')'
   53          | IDENTIF '(' lista_expr ')'

   54 sentencia_control: WHILE '(' expresion ')' '{' lista_sentencias '}'
   55                  | IF '(' expresion ')' '{' lista_sentencias '}'
   56                  | IF '(' expresion ')' '{' lista_sentencias '}' ELSE '{' lista_sentencias '}'
   57                  | FOR '(' for_init ';' expresion ';' for_step ')' '{' lista_sentencias '}'
   58                  | SWITCH '(' expresion ')' '{' lista_cases '}'

   59 for_init: declaracion
   60         | IDENTIF '=' expresion

   61 for_step: IDENTIF '(' IDENTIF ')'
   62         | IDENTIF '=' expresion

   63 lista_cases: case_block
   64            | lista_cases case_block

   65 case_block: CASE cte ':' lista_sentencias BREAK ';'
   66           | DEFAULT ':' lista_sentencias
   67           | DEFAULT ':' lista_sentencias BREAK ';'

   68 expresion: termino
   69          | expresion '+' expresion
   70          | expresion '-' expresion
   71          | expresion '*' expresion
   72          | expresion '/' expresion
   73          | expresion '%' expresion
   74          | expresion '>' expresion
   75          | expresion '<' expresion
   76          | expresion IGUAL expresion
   77          | expresion DIFERENTE expresion
   78          | expresion MAYOR_IGUAL expresion
   79          | expresion MENOR_IGUAL expresion
   80          | expresion AND expresion
   81          | expresion OR expresion
   82          | NOT expresion

   83 termino: operando
   84        | '+' operando
   85        | '-' operando

   86 operando: IDENTIF
   87         | NUMBER
   88         | IDENTIF '[' expresion ']'
   89         | IDENTIF '(' lista_expr ')'
   90         | '(' expresion ')'


